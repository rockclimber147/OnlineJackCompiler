/**
 * Represents character strings. Provides methods for construction, 
 * character manipulation, and integer conversion.
 */
class String {
    field int _maxLength;
    field int length;
    field Array chars;

    /** Constructs a new empty string with a max capacity of maxLength. */
    constructor String new(int maxLength) {
        if (maxLength < 0) { do Sys.error(14); }
        if (maxLength > 0) { let chars = Array.new(maxLength); }
        let _maxLength = maxLength;
        let length = 0;
        return this;
    }

    /** Disposes this string. */
    method void dispose() {
        if (_maxLength > 0) { do chars.dispose(); }
        do Memory.deAlloc(this);
        return;
    }

    method int length() { return length; }

    method char charAt(int j) {
        if ((j < 0) | ~(j < length)) { do Sys.error(15); }
        return chars[j];
    }

    method void setCharAt(int j, char c) {
        if ((j < 0) | ~(j < length)) { do Sys.error(16); }
        let chars[j] = c;
        return;
    }

    method String appendChar(char c) {
        if (length = _maxLength) { do Sys.error(17); }
        let chars[length] = c;
        let length = length + 1;
        return this;
    }

    method void eraseLastChar() {
        if (length = 0) { do Sys.error(18); }
        let length = length - 1;
        return;
    }

    /** Returns the integer value. */
    method int intValue() {
        var int val, i, sign;
        let val = 0;
        let i = 0;
        let sign = 1;
        
        if ((length > 0) & (chars[0] = 45)) {
            let sign = -1;
            let i = 1;
        }

        while (i < length) {
            let val = (val * 10) + (chars[i] - 48);
            let i = i + 1;
        }
        return val * sign;
    }

    /** Sets this string to hold the representation of value. */
    method void setInt(int value) {
        let length = 0;
        if (value < 0) {
            do appendChar(45); // '-'
            let value = -value;
        }
        do addDigits(value);
        return;
    }

    /** Recursive helper for setInt. */
    method void addDigits(int val) {
        var int lastDigit, c;
        let lastDigit = val - ((val / 10) * 10);
        let c = lastDigit + 48;
        
        if (val < 10) {
            do appendChar(c);
        } else {
            do addDigits(val / 10);
            do appendChar(c);
        }
        return;
    }

    function char newLine() { return 128; }
    function char backSpace() { return 129; }
    function char doubleQuote() { return 34; }
}