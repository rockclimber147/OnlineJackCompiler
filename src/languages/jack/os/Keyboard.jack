/**
 * A library for handling user input from the keyboard.
 * Keyboard input is mapped to RAM address 24576.
 */
class Keyboard {
    static int KEYBOARD_ADDRESS;

    /** Initializes the keyboard. */
    function void init() {
        let KEYBOARD_ADDRESS = 24576;
        return;
    }

    /** Returns the character of the currently pressed key (0 if none). */
    function char keyPressed() {
        return Memory.peek(KEYBOARD_ADDRESS);
    }

    /** Waits until a key is pressed and released, then returns that character. */
    function char readChar() {
        var char key;
        // Wait for key press
        while (Keyboard.keyPressed() = 0) {}
        let key = Keyboard.keyPressed();
        // Wait for key release
        while (~(Keyboard.keyPressed() = 0)) {}
        do Output.printChar(key);
        return key;
    }

    /** Reads a line of text from the keyboard and returns it as a new String. */
    function String readLine(String message) {
        return Keyboard._readLine(message, false);
    }

    /** Reads an integer from the keyboard and returns it. */
    function int readInt(String message) {
        var String s;
        let s = Keyboard._readLine(message, true);
        return s.intValue();
    }

    /** Internal helper for reading strings. */
    function String _readLine(String message, boolean onlyDigits) {
        var char key;
        var String ret;
        let ret = String.new(64);

        do Output.printString(message);

        while (true) {
            let key = Keyboard.readChar();
            
            if (key = 128) { // Newline
                do Output.println();
                return ret;
            }
            
            if (key = 129) { // Backspace
                if (ret.length() > 0) {
                    do ret.eraseLastChar();
                    do Output.backSpace();
                }
            } else {
                // Logic: Allow if not onlyDigits OR if key is a digit (ASCII 48-57)
                // Also allow '-' (ASCII 45) if buffer is empty
                if (~onlyDigits | ((key > 47) & (key < 58)) | ((ret.length() = 0) & (key = 45))) {
                    do ret.appendChar(key);
                }
            }
        }
        return ret; // Unreachable
    }
}